{
  "uid": "pg-ha-haproxy",
  "title": "PostgreSQL HA - HAProxy",
  "description": "One HAProxy per data center, identical config. Writes to the primary, reads to replicas.",
  "tags": [
    "pg-ha"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "links": [
    {
      "title": "PostgreSQL HA",
      "type": "dashboards",
      "tags": [
        "pg-ha"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Landing page",
      "type": "link",
      "url": "http://localhost:9090",
      "targetBlank": true,
      "icon": "external link"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "enable": true,
        "iconColor": "#3352C2",
        "name": "Failover / switchover",
        "expr": "changes(max(patroni_postgres_timeline)[1m:15s]) > 0",
        "step": "15s",
        "titleFormat": "New primary (timeline changed)",
        "textFormat": ""
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "enable": true,
        "iconColor": "#C03A3A",
        "name": "Data center powered off / on",
        "expr": "changes(lab_dc_powered_off[1m]) > 0",
        "step": "15s",
        "titleFormat": "{{dc_name}} power changed",
        "textFormat": ""
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "enable": true,
        "iconColor": "#B9800F",
        "name": "Data center partitioned / healed",
        "expr": "changes(lab_dc_partitioned[1m]) > 0",
        "step": "15s",
        "titleFormat": "{{dc_name}} WAN link changed",
        "textFormat": ""
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "options": [],
        "includeAll": false,
        "multi": false
      },
      {
        "name": "dc",
        "label": "Data center",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "query": {
          "query": "label_values(haproxy_backend_status, dc)",
          "refId": "var-dc"
        },
        "definition": "label_values(haproxy_backend_status, dc)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Health",
      "collapsed": false,
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "state-timeline",
      "title": "Backends",
      "description": "postgresql_replicas falls back to postgresql_read_any (the primary) when it has no servers.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "haproxy_backend_status{dc=~\"$dc\", proxy=~\"postgresql_.*\", state=\"UP\"}",
          "legendFormat": "{{dc}} {{proxy}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 85
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Up",
                  "color": "#2B8A66",
                  "index": 0
                },
                "0": {
                  "text": "Down",
                  "color": "#C03A3A",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#C03A3A",
                "value": null
              },
              {
                "color": "#2B8A66",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.85,
        "mergeValues": true,
        "alignValue": "center",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "id": 2,
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "state-timeline",
      "title": "Servers",
      "description": "Serving = that node passes this pool's Patroni check (/primary, /replica or /read-only). Replicas are 'not serving' in the write pool by design; see Backends for real outages.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "haproxy_server_status{dc=~\"$dc\", proxy=~\"postgresql_.*\", state=\"UP\"}",
          "legendFormat": "{{dc}} {{proxy}} {{server}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 85
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Serving",
                  "color": "#2B8A66",
                  "index": 0
                },
                "0": {
                  "text": "Not serving",
                  "color": "rgba(138, 153, 170, 0.35)",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "rgba(138, 153, 170, 0.35)",
                "value": null
              },
              {
                "color": "#2B8A66",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.85,
        "mergeValues": true,
        "alignValue": "center",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "id": 3,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 7
      }
    },
    {
      "type": "timeseries",
      "title": "Active servers per backend",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "haproxy_backend_active_servers{dc=~\"$dc\", proxy=~\"postgresql_.*\"}",
          "legendFormat": "{{dc}} {{proxy}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": 30000,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0,
            "lineInterpolation": "smooth"
          },
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4,
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 17
      }
    },
    {
      "type": "timeseries",
      "title": "Health-check failures",
      "description": "Includes the normal 503s from nodes in the 'wrong' role.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (dc, server) (increase(haproxy_server_check_failures_total{dc=~\"$dc\", proxy=~\"postgresql_.*\"}[$__rate_interval]))",
          "legendFormat": "{{dc}} {{server}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": 30000,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0,
            "lineInterpolation": "smooth"
          },
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5,
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 17
      }
    },
    {
      "type": "row",
      "title": "Traffic",
      "collapsed": false,
      "id": 6,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "panels": []
    },
    {
      "type": "timeseries",
