      }
    },
    {
      "type": "timeseries",
      "title": "Average connect time",
      "description": "Across a data center boundary this includes the WAN round trip.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
