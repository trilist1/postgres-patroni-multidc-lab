          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (dc, proxy) (increase(haproxy_backend_connection_errors_total{dc=~\"$dc\", proxy=~\"postgresql_.*\"}[$__rate_interval]))",
          "legendFormat": "{{dc}} {{proxy}}",
          "refId": "A",
