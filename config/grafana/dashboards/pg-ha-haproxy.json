    {
      "type": "timeseries",
      "title": "Server state changes",
      "description": "Up/down transitions: every failover shows here.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
