          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 25
      }
    },
    {
      "type": "timeseries",
      "title": "Bytes in / out",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (dc) (rate(haproxy_backend_bytes_in_total{dc=~\"$dc\", proxy=~\"postgresql_.*\"}[1m]))",
          "legendFormat": "{{dc}} in",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (dc) (rate(haproxy_backend_bytes_out_total{dc=~\"$dc\", proxy=~\"postgresql_.*\"}[1m]))",
          "legendFormat": "{{dc}} out",
          "refId": "B",
          "range": true,
