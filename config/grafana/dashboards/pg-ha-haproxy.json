      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "haproxy_backend_current_sessions{dc=~\"$dc\", proxy=~\"postgresql_.*\"}",
          "legendFormat": "{{dc}} {{proxy}}",
          "refId": "A",
          "range": true,
