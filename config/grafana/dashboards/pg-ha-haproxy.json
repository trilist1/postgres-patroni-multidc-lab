          "sort": "desc"
        }
      },
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 25
      }
    },
    {
      "type": "timeseries",
      "title": "Sessions per server",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (dc, server) (haproxy_server_current_sessions{dc=~\"$dc\", proxy=~\"postgresql_.*\"})",
          "legendFormat": "{{dc}} {{server}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
