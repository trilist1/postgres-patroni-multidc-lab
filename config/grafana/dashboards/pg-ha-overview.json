{
  "uid": "pg-ha-overview",
  "title": "PostgreSQL HA - Overview",
  "description": "Who is primary, where clients enter, data-center state and failovers, at a glance.",
  "tags": [
    "pg-ha"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "links": [
    {
      "title": "PostgreSQL HA",
      "type": "dashboards",
      "tags": [
        "pg-ha"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Landing page",
      "type": "link",
      "url": "http://localhost:9090",
      "targetBlank": true,
      "icon": "external link"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "enable": true,
        "iconColor": "#3352C2",
        "name": "Failover / switchover",
        "expr": "changes(max(patroni_postgres_timeline)[1m:15s]) > 0",
        "step": "15s",
        "titleFormat": "New primary (timeline changed)",
        "textFormat": ""
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "enable": true,
        "iconColor": "#C03A3A",
        "name": "Data center powered off / on",
        "expr": "changes(lab_dc_powered_off[1m]) > 0",
        "step": "15s",
        "titleFormat": "{{dc_name}} power changed",
        "textFormat": ""
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "enable": true,
        "iconColor": "#B9800F",
        "name": "Data center partitioned / healed",
        "expr": "changes(lab_dc_partitioned[1m]) > 0",
        "step": "15s",
        "titleFormat": "{{dc_name}} WAN link changed",
        "textFormat": ""
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "options": [],
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Right now",
      "collapsed": false,
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Primary",
      "description": "The PostgreSQL node that accepts writes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "patroni_primary == 1",
          "legendFormat": "{{name}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3352C2",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "name",
        "justifyMode": "center",
        "orientation": "auto",
        "showPercentChange": false,
        "wideLayout": true
      },
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      }
    },
