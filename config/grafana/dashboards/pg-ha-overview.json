    {
      "type": "state-timeline",
      "title": "Data center state",
      "description": "Set by lab dc-down / partition or the landing page's failure buttons.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "lab_dc_powered_off * 2 + lab_dc_partitioned",
          "legendFormat": "{{dc_name}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 85
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Running",
                  "color": "#2B8A66",
                  "index": 0
                },
                "1": {
                  "text": "Cut off from the WAN",
                  "color": "#B9800F",
                  "index": 1
                },
                "2": {
                  "text": "Powered off",
                  "color": "#C03A3A",
                  "index": 2
                },
                "3": {
                  "text": "Powered off",
                  "color": "#C03A3A",
                  "index": 3
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#2B8A66",
                "value": null
              },
              {
                "color": "#B9800F",
                "value": 1
              },
              {
                "color": "#C03A3A",
                "value": 2
              },
              {
                "color": "#C03A3A",
                "value": 3
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.85,
        "mergeValues": true,
        "alignValue": "center",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
