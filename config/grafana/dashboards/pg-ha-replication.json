      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "patroni_primary == 1",
          "legendFormat": "{{name}}",
          "refId": "A",
          "range": false,
          "instant": true
