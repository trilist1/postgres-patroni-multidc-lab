      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "patroni_primary",
          "legendFormat": "{{name}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 85
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Primary",
                  "color": "#3352C2",
                  "index": 0
                },
                "0": {
                  "text": "Replica",
                  "color": "#2B8A66",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
