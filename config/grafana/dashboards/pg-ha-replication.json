    {
      "type": "timeseries",
      "title": "Seconds since Patroni last reached etcd",
      "description": "Normal: a saw-tooth up to Patroni's loop_wait (10 s). Keeps climbing on a node cut off from the etcd quorum.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "time() - patroni_dcs_last_seen",
          "legendFormat": "{{name}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
